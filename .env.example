# Base URL da API do Nós Dois. Sem esta variável o app usa http://localhost:8080.
VITE_API_URL=http://localhost:8080

# Client ID do OAuth do Google (tipo "Web application"), usado para iniciar o
# redirect de login. O redirect URI cadastrado no console deve ser
# <origem-do-app>/auth/google/callback (ex: http://localhost:5173/auth/google/callback).
VITE_GOOGLE_CLIENT_ID=
